/**
 * Supported free PSP providers.
 * These provide merchant APIs with ZERO transaction fees.
 * - 'phonepe': PhonePe Business (https://business.phonepe.com)
 * - 'paytm': Paytm Business (https://business.paytm.com)
 */
type Provider = 'phonepe' | 'paytm';
/**
 * Environment mode.
 * - sandbox: Test/UAT APIs. No real money.
 * - production: Live APIs. Real transactions.
 */
type Environment = 'sandbox' | 'production';
/**
 * Normalized payment status.
 */
type PaymentStatus = 'CREATED' | 'PENDING' | 'SUCCESS' | 'FAILED';
/**
 * Payment method used by the customer.
 */
type PaymentMethod = 'upi' | 'wallet' | 'unknown';
/**
 * Configuration for initializing UPIPay.
 */
interface UPIPayConfig {
    /** Free PSP provider to use */
    provider: Provider;
    /** Environment mode */
    environment: Environment;
    /**
     * Provider-specific merchant credentials (from dashboard, always free).
     * Use the correct shape for your provider:
     * - PhonePe: { merchantId, saltKey, saltIndex }
     * - Paytm: { merchantId, merchantKey, website? }
     */
    credentials: Record<string, string>;
    /** Advanced options */
    options?: UPIPayOptions;
}
/**
 * Advanced options.
 */
interface UPIPayOptions {
    /** Request timeout in ms (default: 30000) */
    timeout?: number;
    /** Enable debug logging — secrets auto-redacted (default: false) */
    debug?: boolean;
    /** Custom logger */
    logger?: (level: LogLevel, message: string, data?: Record<string, unknown>) => void;
}
type LogLevel = 'debug' | 'info' | 'warn' | 'error';
/**
 * Request to generate a UPI QR code.
 */
interface UPIQRRequest {
    /** Your UPI VPA / Virtual Payment Address (e.g., 'yourbusiness@ybl') */
    vpa: string;
    /** Business/Merchant display name */
    name: string;
    /** Amount in rupees (e.g., 500.00 for ₹500) */
    amount: number;
    /** Your unique order/transaction reference ID */
    orderId: string;
    /** Optional transaction note shown in UPI app */
    note?: string;
    /**
     * QR amount mode.
     * - `'fixed'` (default): Amount is locked — user CANNOT change it (sets NPCI `mode=04`)
     * - `'open'`: Amount is editable — user can change the amount in their UPI app
     *
     * Use `'fixed'` for invoices, e-commerce, and any scenario where the exact
     * amount must be paid — not even 1 paisa less or more.
     */
    mode?: 'fixed' | 'open';
    /** Optional Merchant Category Code (4-digit MCC as per NPCI/ISO 18245) */
    mc?: string;
}
/**
 * Generated UPI QR code response.
 */
interface UPIQRResponse {
    /** The UPI URI string (upi://pay?pa=...&pn=...&am=...&tr=...) */
    upiUri: string;
    /** Base64-encoded PNG image of the QR code */
    qrImage: string;
    /** The order ID passed in the request */
    orderId: string;
    /** Amount in rupees */
    amount: number;
}
/**
 * UPI deep link / intent for mobile apps.
 */
interface UPIIntentLink {
    /** Generic UPI intent URI (opens any UPI app) */
    generic: string;
    /** PhonePe-specific deep link */
    phonepe: string;
    /** Google Pay deep link */
    gpay: string;
    /** Paytm deep link */
    paytm: string;
    /** BHIM app deep link */
    bhim: string;
}
/**
 * Request to create a payment via PSP merchant API.
 * The PSP will generate a payment page/QR — money goes directly to your bank.
 */
interface CreatePaymentRequest {
    /** Amount in paise (50000 = ₹500.00) */
    amount: number;
    /** Your unique order ID */
    orderId: string;
    /** Customer phone number (10-digit Indian mobile) */
    customerPhone: string;
    /** Customer name (optional but recommended) */
    customerName?: string;
    /** Customer email (optional) */
    customerEmail?: string;
    /** Server-to-server callback URL for webhook */
    callbackUrl: string;
    /** Frontend redirect URL after payment */
    redirectUrl: string;
    /**
     * Caller-supplied idempotency token for the payment creation request.
     * When provided, the PSP will return the same response for duplicate
     * calls carrying the same token, preventing double-session creation
     * on network retries. Use `randomUUID()` or a stable hash of your order ID.
     */
    idempotencyKey?: string;
    /** Additional metadata */
    metadata?: Record<string, unknown>;
}
/**
 * Response from creating a payment.
 */
interface CreatePaymentResponse {
    /** Whether the request succeeded */
    success: boolean;
    /** URL to redirect user to for payment (QR-based checkout page) */
    paymentUrl: string;
    /** Your order ID */
    orderId: string;
    /** PSP's transaction ID */
    providerTransactionId?: string;
    /** Raw response from the PSP */
    rawResponse: unknown;
}
/**
 * Payment status check response.
 */
interface PaymentStatusResponse {
    /** Whether the status check succeeded */
    success: boolean;
    /** Normalized payment status */
    status: PaymentStatus;
    /** Amount in paise */
    amount: number;
    /** Your order ID */
    orderId: string;
    /** PSP's transaction ID */
    transactionId?: string;
    /** Payment method used */
    paymentMethod: PaymentMethod;
    /** Raw response from the PSP */
    rawResponse: unknown;
}
/**
 * Parsed webhook event after verification.
 */
interface WebhookEvent {
    /** Is the webhook signature valid? */
    verified: boolean;
    /** Normalized status */
    status: PaymentStatus;
    /** Your order ID */
    orderId: string;
    /** PSP's transaction ID */
    transactionId?: string;
    /** Amount in paise */
    amount?: number;
    /** Raw payload */
    rawPayload: unknown;
}
/**
 * Options for verifying webhook signatures and validity.
 */
interface WebhookVerifyOptions {
    /**
     * When true, rejects webhooks whose embedded transaction timestamp falls
     * outside the `timestampToleranceSeconds` window.
     *
     * **Default: false.** PSPs embed the *transaction* timestamp (not the webhook
     * delivery time), so enabling this window will silently reject legitimate
     * webhooks that are delayed by network congestion, bank processing, or PSP
     * retry intervals. Use database-level idempotency (unique constraint on
     * `transactionId`) as the reliable replay-prevention mechanism instead.
     */
    enableReplayProtection?: boolean;
    /**
     * The maximum allowed age of the webhook timestamp in seconds (default: 300 seconds).
     */
    timestampToleranceSeconds?: number;
    /**
     * Optional explicit timestamp to verify (Unix timestamp in seconds or Date string).
     * If not provided, the adapter will look for timestamp fields within the payload body.
     */
    timestamp?: number | string;
    /**
     * Expected payment amount in paise. If provided, the SDK will verify that the
     * amount in the webhook payload matches exactly. This prevents amount-substitution
     * attacks where a ₹1 payment webhook is used to fulfil a ₹10,000 order.
     *
     * @example
     * ```typescript
     * const event = client.verifyWebhook(rawBody, signature, {
     *   expectedAmount: 50000, // ₹500.00
     * });
     * ```
     */
    expectedAmount?: number;
}
/**
 * Options for checking payment status.
 */
interface CheckStatusOptions {
    /**
     * The expected amount in paise. If provided, the SDK will verify that the
     * amount returned by the PSP matches this value. This prevents attacks
     * where a ₹1 payment is used to fulfill a ₹10,000 order.
     */
    expectedAmount?: number;
    /**
     * Total number of call attempts including the initial one.
     * The call will be re-attempted on transient network failures
     * using exponential back-off between each attempt.
     * @default 3
     */
    maxRetries?: number;
    /**
     * Base delay in milliseconds for the first retry interval.
     * Subsequent intervals double: baseDelayMs, baseDelayMs * 2, …
     * @default 1000
     */
    retryDelayMs?: number;
}
/** Normalised refund status. */
type RefundStatus = 'PENDING' | 'SUCCESS' | 'FAILED';
/**
 * Request to initiate a refund against a previously completed payment.
 */
interface CreateRefundRequest {
    /**
     * The original order ID that was paid. Must match the value used
     * when calling `createPayment()`.
     */
    originalOrderId: string;
    /**
     * A unique identifier for this refund attempt.
     * Use a stable, distinct value per refund (e.g. `refund_${randomUUID()}`).
     * PSPs use this to deduplicate concurrent or retried refund calls.
     */
    refundId: string;
    /**
     * Amount to refund in paise. Must be ≤ the original transaction amount.
     * Partial refunds are supported by both PhonePe and Paytm.
     */
    amount: number;
    /**
     * The PSP's internal transaction ID for the original payment.
     *
     * **Required for Paytm refunds.** Paytm's `/v3/order/refund` endpoint
     * uses `txnId` to identify the transaction — this is the value returned
     * in `PaymentStatusResponse.transactionId` or `WebhookEvent.transactionId`,
     * not the merchant's `orderId`.
     *
     * For PhonePe this is optional — the adapter uses the merchant transaction
     * ID (`originalOrderId`) internally.
     */
    providerTransactionId?: string;
    /**
     * Optional human-readable reason for the refund.
     * Surfaced in the PSP settlement report and merchant dashboard.
     */
    reason?: string;
}
/**
 * Response returned after initiating a refund.
 */
interface RefundResponse {
    /** Whether the refund request was accepted by the PSP. */
    success: boolean;
    /** Normalised refund status at the time of the response. */
    status: RefundStatus;
    /** Your refund reference ID (mirrors `CreateRefundRequest.refundId`). */
    refundId: string;
    /** The original order ID against which the refund was raised. */
    originalOrderId: string;
    /** Amount refunded in paise. */
    amount: number;
    /** PSP's internal refund transaction reference. */
    providerRefundId?: string;
    /** Raw response from the PSP for advanced inspection. */
    rawResponse: unknown;
}
interface PhonePeCredentials {
    /** Merchant ID from PhonePe Business dashboard */
    merchantId: string;
    /** Salt Key from PhonePe Business dashboard */
    saltKey: string;
    /** Salt Index (usually '1') */
    saltIndex: string;
}
interface PaytmCredentials {
    /** Merchant ID from Paytm Business dashboard */
    merchantId: string;
    /** Merchant Key from Paytm Business dashboard */
    merchantKey: string;
    /** Website name (default: 'WEBSTAGING' for sandbox, 'DEFAULT' for production) */
    website?: string;
}

/**
 * Unified PSP interface.
 * Both PhonePe and Paytm adapters implement this.
 */
interface IPSPAdapter {
    /** Which provider this adapter handles */
    readonly provider: Provider;
    /**
     * Create a payment request with the PSP.
     * Returns a payment URL where the user can pay via UPI QR.
     * Money goes directly to your bank — zero commission.
     */
    createPayment(request: CreatePaymentRequest): Promise<CreatePaymentResponse>;
    /**
     * Check payment status via the PSP's Status API.
     * Use this to verify if a payment was successful.
     * @param orderId - Your order ID
     * @param options - Optional: pass expectedAmount to verify amount integrity
     */
    checkStatus(orderId: string, options?: CheckStatusOptions): Promise<PaymentStatusResponse>;
    /**
     * Verify that a webhook callback is authentic.
     * Uses HMAC/SHA256 checksum verification (constant-time safe).
     *
     * Returns a WebhookEvent with parsed payment details and a `verified` flag.
     */
    verifyWebhook(payload: string | Buffer, signature: string, options?: WebhookVerifyOptions): WebhookEvent;
    /**
     * Initiate a full or partial refund against a previously completed payment.
     * Returns a RefundResponse describing the refund's current state.
     * This operation is always performed over a server-to-server call — the
     * customer's session is not involved.
     */
    createRefund?(request: CreateRefundRequest): Promise<RefundResponse>;
}

/**
 * **UPIPay** — Free, zero-commission UPI payments for India.
 *
 * Accept UPI payments directly into your bank account via the NPCI network.
 * Integrates with PhonePe Business and Paytm Business free merchant APIs.
 * Money goes straight from customer → NPCI → your bank. No middlemen.
 *
 * ### Quick start — UPI QR (no merchant account required):
 * ```typescript
 * import { UPIPay } from 'upipay';
 *
 * const client = new UPIPay({ provider: 'phonepe', environment: 'sandbox', credentials: {...} });
 * const qr = await client.generateQR({ vpa: 'yourbiz@ybl', name: 'My Business', amount: 500, orderId: 'ord_1' });
 * // Render: <img src={qr.qrImage} />
 * ```
 *
 * ### Quick start — Full PSP payment with webhook verification:
 * ```typescript
 * const payment = await client.createPayment({
 *   amount: 50000,          // ₹500.00 in paise
 *   orderId: 'ord_1',
 *   customerPhone: '9876543210',
 *   callbackUrl: 'https://yoursite.com/webhook',
 *   redirectUrl: 'https://yoursite.com/done',
 * });
 * // Redirect user to payment.paymentUrl
 * ```
 */
declare class UPIPay {
    private readonly adapter;
    private readonly config;
    private readonly logger;
    constructor(config: UPIPayConfig);
    /** Active payment provider */
    get provider(): Provider;
    /** Active environment ('sandbox' or 'production') */
    get environment(): Environment;
    /**
     * Generate an NPCI-compliant UPI QR code.
     *
     * The customer scans the QR with any UPI app (PhonePe, Google Pay, Paytm,
     * BHIM, etc.) and pays directly into your registered bank account.
     * Zero commission, no merchant account required.
     *
     * > **Important:** QR-only payments have no webhook or status API.
     * > You must verify receipt manually (bank SMS, Soundbox, portal).
     * > For automated, server-side verification use `createPayment()` instead.
     *
     * @param request - VPA, display name, amount (in rupees), and orderId
     */
    generateQR(request: UPIQRRequest): Promise<UPIQRResponse>;
    /**
     * Build a UPI URI string without rendering a QR image.
     * Useful for sending payment links over WhatsApp or SMS.
     */
    buildUPILink(request: UPIQRRequest): string;
    /**
     * Build app-specific UPI deep links (PhonePe, Google Pay, Paytm, BHIM).
     * Opens the chosen UPI app with payment details pre-filled.
     */
    buildIntentLinks(request: UPIQRRequest): UPIIntentLink;
    /**
     * Initiate a payment via the PSP merchant API.
     *
     * Returns a hosted payment URL where the customer pays via UPI.
     * After payment, the PSP delivers a signed webhook to your `callbackUrl`.
     * Use `verifyWebhook()` to authenticate it, then `checkStatus()` to
     * confirm the final state before fulfilling the order.
     *
     * @param request - Payment details including amount (in paise), orderId, phone
     */
    createPayment(request: CreatePaymentRequest): Promise<CreatePaymentResponse>;
    /**
     * Check the confirmed status of a payment via the PSP Status API.
     *
     * Always call this after receiving a webhook — never rely solely on the
     * webhook payload. Passing `expectedAmount` adds an extra layer of
     * protection: the SDK will throw if the PSP-returned amount differs from
     * what you originally charged, preventing amount-substitution attacks.
     *
     * @param orderId - Your order ID
     * @param options - Optional `expectedAmount` in paise for amount verification
     */
    checkStatus(orderId: string, options?: CheckStatusOptions): Promise<PaymentStatusResponse>;
    /**
     * Authenticate a PSP webhook callback and parse its payment event.
     *
     * Always pass the **raw** HTTP request body (`Buffer` or `string`),
     * never a parsed JSON object. Parsing the body before verification
     * allows serialisation-order attacks that bypass signature checks.
     *
     * Replay protection is opt-in — pass `{ enableReplayProtection: true }` to
     * enable timestamp-based stale-webhook rejection. Use database-level
     * idempotency (unique constraint on `transactionId`) as the primary
     * replay-prevention mechanism.
     *
     * Returns a `WebhookEvent` containing:
     * - `verified` — whether the signature is authentic
     * - `status` — normalised payment status: `SUCCESS | PENDING | FAILED`
     * - `orderId` — your order reference, safe to use as an idempotency key
     * - `amount` — amount in paise as reported by the PSP
     * - `transactionId` — the PSP's internal transaction reference
     *
     * @param payload - Raw HTTP request body
     * @param signature - PSP signature header (`x-verify` for PhonePe, `CHECKSUMHASH` for Paytm)
     * @param options - Replay protection tolerance settings
     */
    verifyWebhook(payload: string | Buffer, signature: string, options?: WebhookVerifyOptions): WebhookEvent;
    /**
     * Initiate a full or partial refund for a previously completed payment.
     *
     * Uses the PSP's refund endpoint to reverse the transaction amount (or a
     * portion of it) back to the customer's originating payment instrument.
     * Partial refunds are supported — pass an `amount` in paise that is less
     * than or equal to the original transaction amount.
     *
     * The returned `status` may be `PENDING` on first response. Listen for the
     * PSP's refund webhook or poll using `checkStatus` to confirm settlement.
     *
     * @param request - Refund details: original order ID, unique refund ID, amount in paise
     */
    createRefund(request: CreateRefundRequest): Promise<RefundResponse>;
    /**
     * Returns the underlying PSP adapter for advanced or provider-specific use cases.
     */
    getAdapter(): IPSPAdapter;
    private createAdapter;
}

/**
 * Build a standard NPCI-compliant UPI URI.
 *
 * Format: upi://pay?pa=VPA&pn=Name&am=Amount&tr=TransactionRef&cu=INR
 *
 * This URI is understood by ALL UPI apps (PhonePe, GPay, Paytm, BHIM, etc.)
 *
 * > [!WARNING]
 * > **QR-Only Flow Limitations**: This method does not support automated payment
 * > verification. There is no webhook/callback mechanism or Status API. Payments
 * > must be verified manually (e.g. SMS, soundbox, bank statement).
 *
 * @param request - UPI payment details
 * @returns The UPI URI string
 */
declare function buildUPIUri(request: UPIQRRequest): string;
/**
 * Generate UPI deep links for specific apps.
 *
 * These open the specific UPI app directly on the user's phone,
 * with all payment details pre-filled.
 *
 * > [!WARNING]
 * > **QR-Only Flow Limitations**: This method does not support automated payment
 * > verification. There is no webhook/callback mechanism or Status API. Payments
 * > must be verified manually (e.g. SMS, soundbox, bank statement).
 *
 * @param upiUri - The base UPI URI
 * @returns Deep links for PhonePe, GPay, Paytm, and BHIM
 */
declare function buildIntentLinks(upiUri: string): UPIIntentLink;
/**
 * Generate a UPI QR code image.
 *
 * Creates a dynamic QR code with your VPA, amount, and order ID pre-filled.
 * When a customer scans this QR code with ANY UPI app, the payment goes
 * DIRECTLY to your bank account. Zero commission. No middleman.
 *
 * > [!WARNING]
 * > **QR-Only Flow Limitations**: This method does not support automated payment
 * > verification. There is no webhook/callback mechanism or Status API. Payments
 * > must be verified manually (e.g. SMS, soundbox, bank statement).
 *
 * @param request - UPI payment details (VPA, amount, order ID, name)
 * @returns QR image (base64 PNG) + UPI URI + metadata
 *
 * @example
 * ```typescript
 * import { generateUPIQR } from 'upipay/qr';
 *
 * const qr = await generateUPIQR({
 *   vpa: 'mybusiness@ybl',
 *   name: 'My Business',
 *   amount: 500.00,
 *   orderId: 'order_123',
 * });
 *
 * // Display qr.qrImage as <img src={qr.qrImage} /> in your frontend
 * // Or send qr.upiUri as a payment link
 * ```
 */
declare function generateUPIQR(request: UPIQRRequest): Promise<UPIQRResponse>;
/**
 * Generate a UPI QR code as a raw SVG string.
 * Useful for server-side rendering or embedding in HTML.
 *
 * > [!WARNING]
 * > **QR-Only Flow Limitations**: This method does not support automated payment
 * > verification. There is no webhook/callback mechanism or Status API. Payments
 * > must be verified manually (e.g. SMS, soundbox, bank statement).
 *
 * @param request - UPI payment details
 * @returns SVG string of the QR code
 */
declare function generateUPIQRSvg(request: UPIQRRequest): Promise<string>;
/**
 * Generate a UPI QR code as a raw Buffer (PNG).
 * Useful for saving to file or sending as API response.
 *
 * > [!WARNING]
 * > **QR-Only Flow Limitations**: This method does not support automated payment
 * > verification. There is no webhook/callback mechanism or Status API. Payments
 * > must be verified manually (e.g. SMS, soundbox, bank statement).
 *
 * @param request - UPI payment details
 * @returns PNG Buffer of the QR code
 */
declare function generateUPIQRBuffer(request: UPIQRRequest): Promise<Buffer>;

/**
 * Safely converts an amount in Rupees (decimal) to Paise (integer)
 * to avoid JavaScript floating-point precision issues (e.g. 5.99 * 100 = 599.0000000000001).
 *
 * @param rupees The amount in rupees (e.g. 5.99)
 * @returns The rounded amount in paise (e.g. 599)
 */
declare function rupeesToPaise(rupees: number): number;

/**
 * Base error class for all UPIPay errors.
 */
declare class UPIPayError extends Error {
    readonly code: string;
    readonly provider?: string;
    readonly isRetriable: boolean;
    constructor(message: string, options?: {
        code?: string;
        provider?: string;
        isRetriable?: boolean;
        cause?: unknown;
    });
}
/** Invalid configuration (missing credentials, bad provider name, etc.) */
declare class InvalidConfigError extends UPIPayError {
    constructor(message: string, provider?: string);
}
/** Payment creation or verification failed */
declare class PaymentError extends UPIPayError {
    constructor(message: string, options?: {
        provider?: string;
        isRetriable?: boolean;
        cause?: unknown;
    });
}
/** Webhook signature verification failed — security event */
declare class WebhookVerificationError extends UPIPayError {
    constructor(message: string, provider?: string);
}
/** Network error — always retriable */
declare class NetworkError extends UPIPayError {
    constructor(message: string, options?: {
        provider?: string;
        cause?: unknown;
    });
}
/** Refund initiation or status check failed */
declare class RefundError extends UPIPayError {
    constructor(message: string, options?: {
        provider?: string;
        isRetriable?: boolean;
        cause?: unknown;
    });
}

/**
 * PhonePe Business adapter — FREE, zero-commission UPI payments.
 *
 * @example
 * ```typescript
 * import { PhonePeAdapter } from 'upipay/phonepe';
 *
 * const phonepe = new PhonePeAdapter(
 *   {
 *     merchantId: process.env.PHONEPE_MERCHANT_ID!,
 *     saltKey: process.env.PHONEPE_SALT_KEY!,
 *     saltIndex: '1',
 *   },
 *   'sandbox',
 * );
 *
 * // Create payment — user pays via UPI, money goes to your bank
 * const payment = await phonepe.createPayment({
 *   amount: 50000,  // ₹500.00 in paise
 *   orderId: 'order_123',
 *   customerPhone: '9876543210',
 *   callbackUrl: 'https://yoursite.com/webhook',
 *   redirectUrl: 'https://yoursite.com/payment-complete',
 *   idempotencyKey: randomUUID(), // Prevents duplicate sessions on network retries
 * });
 *
 * // Redirect user to payment.paymentUrl
 * ```
 */
declare class PhonePeAdapter implements IPSPAdapter {
    readonly provider: "phonepe";
    private readonly credentials;
    private readonly baseUrl;
    private readonly logger;
    private readonly timeout;
    constructor(credentials: PhonePeCredentials, environment: Environment, options?: UPIPayOptions);
    createPayment(request: CreatePaymentRequest): Promise<CreatePaymentResponse>;
    checkStatus(orderId: string, options?: CheckStatusOptions): Promise<PaymentStatusResponse>;
    private fetchStatus;
    verifyWebhook(payload: string | Buffer, signature: string, options?: WebhookVerifyOptions): WebhookEvent;
    /**
     * Initiate a full or partial refund for a previously completed PhonePe payment.
     *
     * PhonePe processes refunds via `/pg/v1/refund`. Partial refunds are supported
     * by passing an `amount` value less than the original transaction amount.
     * Refund status may be `PENDING` on first response — poll `checkStatus` or
     * listen for a refund webhook to determine the final settled state.
     *
     * @param request - Refund details including original order ID, refund ID, and amount in paise.
     */
    createRefund(request: CreateRefundRequest): Promise<RefundResponse>;
    /** Generate PhonePe X-VERIFY checksum: SHA256(base64Payload + path + saltKey) + ### + saltIndex */
    private generateChecksum;
    /** Generate callback verification checksum: SHA256(response + saltKey) + ### + saltIndex */
    private generateCallbackChecksum;
    private mapStatus;
    private mapRefundStatus;
    private mapMethod;
    private wrapError;
}

/**
 * Paytm Business adapter — FREE, zero-commission UPI payments.
 *
 * @example
 * ```typescript
 * import { PaytmAdapter } from 'upipay/paytm';
 *
 * const paytm = new PaytmAdapter(
 *   {
 *     merchantId: process.env.PAYTM_MERCHANT_ID!,
