{
  "name": "upipay",
  "version": "1.0.0",
  "description": "Accept UPI payments in Node.js for free. Zero commission. Works with PhonePe Business & Paytm Business APIs. Includes UPI QR code generation, webhook verification, and payment status checks. TypeScript-first, production-ready.",
  "author": "Robin Sharaya <robin.sharaya@gmail.com> (https://github.com/iamrobinsharaya)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./phonepe": {
      "types": "./dist/adapters/phonepe.d.ts",
      "import": "./dist/adapters/phonepe.js",
      "require": "./dist/adapters/phonepe.cjs"
    },
    "./paytm": {
      "types": "./dist/adapters/paytm.d.ts",
      "import": "./dist/adapters/paytm.js",
      "require": "./dist/adapters/paytm.cjs"
    },
    "./qr": {
      "types": "./dist/upi/qr.d.ts",
      "import": "./dist/upi/qr.js",
      "require": "./dist/upi/qr.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "upi",
    "upi-payment",
    "upi-india",
    "accept-upi-payments",
    "upi-nodejs",
    "upi-payment-gateway",
    "free-payment-gateway-india",
    "zero-commission-payment",
    "phonepe",
    "phonepe-api",
    "phonepe-business",
    "phonepe-nodejs",
    "paytm",
    "paytm-api",
    "paytm-business",
    "paytm-nodejs",
    "upi-qr-code",
    "upi-qr-generator",
    "npci-upi",
    "bhim-upi",
    "gpay",
    "google-pay",
    "india-payment",
    "razorpay-alternative",
    "payment-gateway-india",
    "upi-webhook",
    "typescript",
    "payment",
    "merchant",
    "zero-mdr"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamrobinsharaya/upipay.git"
  },
  "homepage": "https://github.com/iamrobinsharaya/upipay#readme",
  "bugs": {
    "url": "https://github.com/iamrobinsharaya/upipay/issues"
  }
}